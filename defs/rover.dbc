BO_ 1794 TEXT_TO_NODE_ORIN: 8 ORIN
  SG_ SEQ : 0|8@1+ (1,0) [0|255] "" ANY
  SG_ C0 : 8|8@1+ (1,0) [0|255] "" ANY
  SG_ C1 : 16|8@1+ (1,0) [0|255] "" ANY
  SG_ C2 : 24|8@1+ (1,0) [0|255] "" ANY
  SG_ C3 : 32|8@1+ (1,0) [0|255] "" ANY
  SG_ C4 : 40|8@1+ (1,0) [0|255] "" ANY
  SG_ C5 : 48|8@1+ (1,0) [0|255] "" ANY
  SG_ C6 : 56|8@1+ (1,0) [0|255] "" ANY

BO_ 1795 TEXT_TO_NODE_RPI: 8 RPI
  SG_ SEQ : 0|8@1+ (1,0) [0|255] "" ANY
  SG_ C0 : 8|8@1+ (1,0) [0|255] "" ANY
  SG_ C1 : 16|8@1+ (1,0) [0|255] "" ANY
  SG_ C2 : 24|8@1+ (1,0) [0|255] "" ANY
  SG_ C3 : 32|8@1+ (1,0) [0|255] "" ANY
  SG_ C4 : 40|8@1+ (1,0) [0|255] "" ANY
  SG_ C5 : 48|8@1+ (1,0) [0|255] "" ANY
  SG_ C6 : 56|8@1+ (1,0) [0|255] "" ANY

BO_ 1796 TEXT_TO_NODE_TOOL: 8 TOOL
  SG_ SEQ : 0|8@1+ (1,0) [0|255] "" ANY
  SG_ C0 : 8|8@1+ (1,0) [0|255] "" ANY
  SG_ C1 : 16|8@1+ (1,0) [0|255] "" ANY
  SG_ C2 : 24|8@1+ (1,0) [0|255] "" ANY
  SG_ C3 : 32|8@1+ (1,0) [0|255] "" ANY
  SG_ C4 : 40|8@1+ (1,0) [0|255] "" ANY
  SG_ C5 : 48|8@1+ (1,0) [0|255] "" ANY
  SG_ C6 : 56|8@1+ (1,0) [0|255] "" ANY

BO_ 2045 TEXT_FROM_NODE: 8 ANY
  SG_ SEQ : 0|8@1+ (1,0) [0|255] "" ORIN,RPI,TOOL
  SG_ C0 : 8|8@1+ (1,0) [0|255] "" ORIN,RPI,TOOL
  SG_ C1 : 16|8@1+ (1,0) [0|255] "" ORIN,RPI,TOOL
